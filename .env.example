# ============================================================
# BANCO DE DADOS (Postgres)
# ============================================================
# Copie este arquivo para `.env` e preencha com seus valores reais.
# O `.env` NUNCA é commitado; este `.env.example` é um modelo seguro de commit.
#
# Desenvolvimento: use o Neon (https://neon.tech) - plano grátis, sem instalar nada.
# 1) Crie a conta, crie um projeto e copie a "connection string" do banco.
# 2) Cole abaixo trocando USER, SENHA, HOST e DB pelos valores do seu projeto.
# OBS: esta é a URL do DONO do banco (usada só pelas migrations via Prisma CLI).
DATABASE_URL="postgresql://USER:SENHA@ep-EXEMPLO.us-east-2.aws.neon.tech/crm?sslmode=verify-full"

# ============================================================
# CONEXÃO DA APLICAÇÃO (papel app_user - SEM BYPASSRLS)
# ============================================================
# O dono do banco no Neon tem a flag BYPASSRLS, que ignora o Row Level Security
# (isolamento entre tenants). A aplicação NÃO deve conectar como o dono.
# Crie um papel dedicado sem BYPASSRLS e conceda privilégios nas tabelas.
# Rode o script pronto (idempotente) e configure a senha do papel:
#   psql "<DATABASE_URL>" -f scripts/grant_app_user.sql
#   ALTER ROLE app_user WITH PASSWORD '...';
# A connection string abaixo usa esse papel (não o dono).
APP_DATABASE_URL="postgresql://app_user:SENHA@ep-EXEMPLO.us-east-2.aws.neon.tech/crm?sslmode=verify-full"

# ============================================================
# AUTENTICAÇÃO (Clerk) - Fase 3
# ============================================================
# Crie uma aplicação em https://dashboard.clerk.com -> API Keys e copie as duas
# chaves. A publicável (pk_test_) vai no cliente; a secreta (sk_test_) só no
# servidor (NUNCA expor em código ou no cliente).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Páginas de login/cadastro e para onde voltar depois de entrar.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL="/"
# Webhook de sincronização: no painel do Clerk, seção Webhooks, crie o endpoint
# /api/webhooks/clerk para os eventos user.created, user.updated, user.deleted
# e cole o "signing secret" (começa com whsec_).
# ============================================================
# MONITORAMENTO (Sentry) - Fase 11 (opcional, plano grátis generoso)
# ============================================================
# Crie um projeto em https://sentry.io -> Settings -> Projects -> New Project.
# Copie o DSN (Data Source Name) e cole abaixo.
# Para upload de sourcemaps no build, também defina SENTRY_AUTH_TOKEN
# (Settings -> Auth Tokens -> New Token, escopo project:write).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""