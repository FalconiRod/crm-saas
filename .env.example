# ============================================================
# BANCO DE DADOS (Postgres)
# ============================================================
# Copie este arquivo para `.env` e preencha com seus valores reais.
# O `.env` NUNCA é commitado; este `.env.example` é um modelo seguro de commit.
#
# Desenvolvimento: use o Neon (https://neon.tech) - plano grátis, sem instalar nada.
# 1) Crie a conta, crie um projeto e copie a "connection string" do banco.
# 2) Cole abaixo trocando USER, SENHA, HOST e DB pelos valores do seu projeto.
# OBS: esta é a URL do DONO do banco (usada só pelas migrations via Prisma CLI).
DATABASE_URL="postgresql://USER:SENHA@ep-EXEMPLO.us-east-2.aws.neon.tech/crm?sslmode=require"

# ============================================================
# CONEXÃO DA APLICAÇÃO (papel app_user - SEM BYPASSRLS)
# ============================================================
# O dono do banco no Neon tem a flag BYPASSRLS, que ignora o Row Level Security
# (isolamento entre tenants). A aplicação NÃO deve conectar como o dono.
# Crie um papel dedicado sem BYPASSRLS e conceda privilégios nas tabelas:
#   CREATE ROLE app_user WITH LOGIN PASSWORD '...';
#   GRANT USAGE ON SCHEMA public TO app_user;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO app_user;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO app_user;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_user;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO app_user;
APP_DATABASE_URL="postgresql://app_user:SENHA@ep-EXEMPLO.us-east-2.aws.neon.tech/crm?sslmode=require"

# ============================================================
# AUTENTICAÇÃO (Clerk) - preencher na FASE 3
# ============================================================
# Crie uma aplicação em https://dashboard.clerk.com e copie as duas chaves.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."